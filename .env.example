# .env.example - placeholder names only. Leave every value empty in this repo.
# Credentials (API keys, tokens, passwords) live ONLY in Make / Airtable connections
# inside the client's own accounts. Never put secrets in this repo, in a .env file
# that is committed, or in any client profile.
# The names below are non-secret identifiers used to point the template at a client's accounts.

# Client
CLIENT_NAME=
MARKET=
CLIENT_TIMEZONE=

# Airtable (Brand Brain)
AIRTABLE_WORKSPACE_ID=
AIRTABLE_BASE_ID=

# Make
MAKE_ORG_ID=
MAKE_TEAM_ID=
MAKE_FOLDER_ID=

# Shopify
SHOPIFY_STORE_DOMAIN=

# Meta
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=

# Google (US)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_MERCHANT_CENTER_ID=

# TikTok
TIKTOK_ADVERTISER_ID=

# WhatsApp Business Cloud (PK)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

# Klaviyo (US)
KLAVIYO_ACCOUNT_ID=

# Gorgias (US)
GORGIAS_SUBDOMAIN=

# Daily brief
BRIEF_SEND_TIME=
BRIEF_RECIPIENTS=
