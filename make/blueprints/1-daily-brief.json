{"name": "1. Daily brief (MASTER)", "metadata": {"version": 1, "scenario": {"roundtrips": 1, "maxErrors": 3, "autoCommit": true, "sequential": false, "confidential": false, "dataloss": false, "dlq": false}, "designer": {"orphans": []}}, "flow": [
{"id": 1, "module": "util:SetVariables", "version": 1, "parameters": {}, "mapper": {"scope": "roundtrip", "variables": [{"name": "market", "value": "PK"}, {"name": "brand", "value": "CLIENT_NAME"}, {"name": "currency", "value": "PKR"}, {"name": "day", "value": "{{formatDate(addDays(now; -1); \"YYYY-MM-DD\")}}"}, {"name": "today", "value": "{{formatDate(now; \"YYYY-MM-DD\")}}"}]}, "metadata": {"designer": {"x": 0, "y": 0, "name": "CONFIG: market, brand, dates"}}},
{"id": 2, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "created_at:>={{1.day}} created_at:<{{1.today}}", "sortKey": "created-desc", "limit": 250, "lineItems": false}, "metadata": {"designer": {"x": 300, "y": 0, "name": "Shopify: all orders yesterday"}}},
{"id": 3, "module": "builtin:BasicAggregator", "version": 1, "parameters": {"feeder": 2}, "mapper": {"name": "{{2.name}}", "totalPriceSet": "{{2.totalPriceSet}}", "displayFinancialStatus": "{{2.displayFinancialStatus}}"}, "metadata": {"designer": {"x": 600, "y": 0, "name": "Collect orders"}}},
{"id": 4, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "tag:cod-confirmed created_at:>={{1.day}} created_at:<{{1.today}}", "sortKey": "created-desc", "limit": 250, "lineItems": false}, "metadata": {"designer": {"x": 900, "y": 0, "name": "Shopify: COD confirmed (PK)"}}},
{"id": 5, "module": "builtin:BasicAggregator", "version": 1, "parameters": {"feeder": 4}, "mapper": {"name": "{{4.name}}"}, "metadata": {"designer": {"x": 1200, "y": 0, "name": "Collect confirmed"}}},
{"id": 6, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "(tag:cod-cancelled OR tag:cod-no-reply) created_at:>={{1.day}} created_at:<{{1.today}}", "sortKey": "created-desc", "limit": 250, "lineItems": false}, "metadata": {"designer": {"x": 1500, "y": 0, "name": "Shopify: COD cancelled / no reply (PK)"}}},
{"id": 7, "module": "builtin:BasicAggregator", "version": 1, "parameters": {"feeder": 6}, "mapper": {"name": "{{6.name}}"}, "metadata": {"designer": {"x": 1800, "y": 0, "name": "Collect cancelled"}}},
{"id": 8, "module": "facebook-insights:GetAdAccountInsights", "version": 1, "parameters": {}, "mapper": {"type": "adAccount", "specify_date": "date_preset", "date_preset": "yesterday", "fields": ["spend", "impressions", "clicks"], "limit": 10}, "metadata": {"designer": {"x": 2100, "y": 0, "name": "Meta: ad account insights yesterday"}}},
{"id": 9, "module": "builtin:BasicAggregator", "version": 1, "parameters": {"feeder": 8}, "mapper": {"spend": "{{8.spend}}"}, "metadata": {"designer": {"x": 2400, "y": 0, "name": "Collect ad spend"}}},
{"id": 10, "module": "util:SetVariables", "version": 1, "parameters": {}, "mapper": {"scope": "roundtrip", "variables": [{"name": "revenue", "value": "{{sum(map(3.array; \"totalPriceSet.amount\"))}}"}, {"name": "orders", "value": "{{length(3.array)}}"}, {"name": "ad_spend", "value": "{{sum(map(9.array; \"spend\"))}}"}, {"name": "mer", "value": "{{if(sum(map(9.array; \"spend\")) > 0; round(sum(map(3.array; \"totalPriceSet.amount\")) / sum(map(9.array; \"spend\")) * 100) / 100; 0)}}"}, {"name": "confirmed", "value": "{{length(5.array)}}"}, {"name": "cancelled", "value": "{{length(7.array)}}"}, {"name": "confirmed_pct", "value": "{{if(length(5.array) + length(7.array) > 0; length(5.array) / (length(5.array) + length(7.array)); 0)}}"}]}, "metadata": {"designer": {"x": 2700, "y": 0, "name": "METRICS"}}},
{"id": 11, "module": "ai-tools:Ask", "version": 2, "parameters": {}, "mapper": {"input": "You are the finance and KPI agent for an e-commerce brand. Write a daily brief for the owner in plain English, maximum 120 words. Use only the numbers below; never invent numbers. Structure: 1) one-line headline, 2) three bullet points on what changed or needs attention, 3) one suggested action that needs approval, if any. Do not make health, safety or best/#1 claims.\n\nBrand: {{1.brand}}\nMarket: {{1.market}}\nDate: {{1.day}}\nCurrency: {{1.currency}}\nRevenue: {{10.revenue}}\nOrders: {{10.orders}}\nAd spend (Meta): {{10.ad_spend}}\nMER (revenue / ad spend): {{10.mer}}\nPakistan only - COD confirmed: {{10.confirmed}}, COD cancelled or no reply: {{10.cancelled}}"}, "metadata": {"designer": {"x": 3000, "y": 0, "name": "AI summary"}}},
{"id": 12, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblJCw8T8rM3GGmWV", "typecast": true, "useColumnId": true, "record": {"fldKgmDYae4mkwSe1": "{{1.day}}", "fldwHV7JSkjJWMLyI": "{{1.market}}", "fldQRITPK5S1K8SXM": "{{10.revenue}}", "fld4eYLgyljVGFzWe": "{{10.orders}}", "fldnjL0BGzw7ZYGnn": "{{10.ad_spend}}", "fldBqtOYJYEpajCim": "{{10.mer}}", "fld1yKB7FgEIUW8zC": "{{if(1.market = \"PK\"; 10.confirmed_pct; null)}}", "fldyxVAgQpahJkRkG": "{{11.answer}}"}}, "metadata": {"designer": {"x": 3300, "y": 0, "name": "Airtable: Daily Briefs row"}}},
{"id": 13, "module": "email:ActionSendMeEmail", "version": 7, "parameters": {}, "mapper": {"to": "OWNER_EMAIL", "subject": "Daily brief {{1.day}} - {{1.brand}}", "html": "<p><b>{{1.brand}} ({{1.market}}) - {{1.day}}</b></p><p>Revenue: {{10.revenue}} {{1.currency}}<br>Orders: {{10.orders}}<br>Ad spend: {{10.ad_spend}}<br>MER: {{10.mer}}<br>COD confirmed / cancelled (PK): {{10.confirmed}} / {{10.cancelled}}</p><p>{{replace(11.answer; newline; \"<br>\")}}</p>"}, "metadata": {"designer": {"x": 3600, "y": 0, "name": "Email brief to owner"}}},
{"id": 14, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblhK6iEKzos8bAue", "typecast": true, "useColumnId": true, "record": {"fld8CQl8czLLy0s5w": "Daily brief sent for {{1.day}}", "fld29uaxQk5VmdXsI": "{{now}}", "fldUPfdwpl2mb1le5": "Orchestrator", "fldxsNlnxUGh8Xb3s": "Make", "fldStlIKxufuTP8MG": "Revenue {{10.revenue}}, orders {{10.orders}}, ad spend {{10.ad_spend}}, MER {{10.mer}}", "fldSGDQm5YJyb6gFD": "Success"}}, "metadata": {"designer": {"x": 3900, "y": 0, "name": "Airtable: Agent Action Log"}}}
]}
