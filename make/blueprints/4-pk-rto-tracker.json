{"name": "4. PK RTO tracker - courier status (MASTER)", "metadata": {"version": 1, "scenario": {"roundtrips": 1, "maxErrors": 3, "autoCommit": true, "sequential": true, "confidential": false, "dataloss": false, "dlq": false}, "designer": {"orphans": []}}, "flow": [
