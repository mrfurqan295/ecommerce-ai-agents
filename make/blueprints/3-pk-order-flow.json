{"name": "3. PK order flow - COD confirm, remind, cancel (MASTER)", "metadata": {"version": 1, "scenario": {"roundtrips": 1, "maxErrors": 3, "autoCommit": true, "sequential": true, "confidential": false, "dataloss": false, "dlq": false}, "designer": {"orphans": []}}, "flow": [
{"id": 1, "module": "util:SetVariables", "version": 1, "parameters": {}, "mapper": {"scope": "roundtrip", "variables": [{"name": "new_since", "value": "{{formatDate(addHours(now; -24); \"YYYY-MM-DDTHH:mm:ss\"; \"UTC\")}}Z"}, {"name": "reminder_cutoff", "value": "{{formatDate(addHours(now; -4); \"YYYY-MM-DDTHH:mm:ss\"; \"UTC\")}}Z"}, {"name": "cancel_cutoff", "value": "{{formatDate(addHours(now; -24); \"YYYY-MM-DDTHH:mm:ss\"; \"UTC\")}}Z"}, {"name": "sender_id", "value": "WHATSAPP_PHONE_NUMBER_ID"}]}, "metadata": {"designer": {"x": 0, "y": 0, "name": "CONFIG: reminder 4 h, cancel 24 h (editable)"}}},
{"id": 2, "module": "builtin:BasicRouter", "version": 1, "mapper": null, "metadata": {"designer": {"x": 300, "y": 0}}, "routes": [
{"flow": [
{"id": 3, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "status:open financial_status:pending -tag:prepaid -tag:cod-pending -tag:cod-confirmed -tag:cod-cancelled -tag:cod-no-reply created_at:>{{1.new_since}}", "sortKey": "created-asc", "limit": 50, "lineItems": false}, "metadata": {"designer": {"x": 600, "y": -300, "name": "New COD orders (no COD tag yet)"}}},
{"id": 4, "module": "whatsapp-business-cloud:sendTemplateMessage", "version": 1, "parameters": {}, "mapper": {"fromId": "{{1.sender_id}}", "to": "{{3.shippingAddress.phone}}", "messageTemplate": "order_confirmation"}, "metadata": {"designer": {"x": 900, "y": -300, "name": "WhatsApp: order_confirmation (Confirm / Cancel)"}}},
{"id": 5, "module": "shopify:makeAnApiCall", "version": 3, "parameters": {}, "mapper": {"query": "mutation { tagsAdd(id: \"{{3.id}}\", tags: [\"cod-pending\"]) { userErrors { field message } } }"}, "metadata": {"designer": {"x": 1200, "y": -300, "name": "Tag order cod-pending"}}},
{"id": 6, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblhK6iEKzos8bAue", "typecast": true, "useColumnId": true, "record": {"fld8CQl8czLLy0s5w": "COD confirmation sent: {{3.name}}", "fld29uaxQk5VmdXsI": "{{now}}", "fldUPfdwpl2mb1le5": "Orders & Shipping", "fldxsNlnxUGh8Xb3s": "WhatsApp", "fldStlIKxufuTP8MG": "Tag cod-pending", "fldSGDQm5YJyb6gFD": "Success"}}, "metadata": {"designer": {"x": 1500, "y": -300, "name": "Agent Action Log"}}}
]},
{"flow": [
{"id": 7, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "status:open tag:cod-pending -tag:cod-reminded created_at:<{{1.reminder_cutoff}} created_at:>{{1.cancel_cutoff}}", "sortKey": "created-asc", "limit": 50, "lineItems": false}, "metadata": {"designer": {"x": 600, "y": 0, "name": "Pending over 4 h, not reminded"}}},
{"id": 8, "module": "whatsapp-business-cloud:sendTemplateMessage", "version": 1, "parameters": {}, "mapper": {"fromId": "{{1.sender_id}}", "to": "{{7.shippingAddress.phone}}", "messageTemplate": "confirmation_reminder"}, "metadata": {"designer": {"x": 900, "y": 0, "name": "WhatsApp: confirmation_reminder"}}},
{"id": 9, "module": "shopify:makeAnApiCall", "version": 3, "parameters": {}, "mapper": {"query": "mutation { tagsAdd(id: \"{{7.id}}\", tags: [\"cod-reminded\"]) { userErrors { field message } } }"}, "metadata": {"designer": {"x": 1200, "y": 0, "name": "Tag order cod-reminded"}}}
]},
{"flow": [
{"id": 10, "module": "shopify:searchOrders", "version": 3, "parameters": {}, "mapper": {"queryMode": "advanced", "query": "status:open tag:cod-pending created_at:<{{1.cancel_cutoff}}", "sortKey": "created-asc", "limit": 50, "lineItems": false}, "metadata": {"designer": {"x": 600, "y": 300, "name": "Pending over 24 h, no reply"}}},
{"id": 11, "module": "shopify:makeAnApiCall", "version": 3, "parameters": {}, "mapper": {"query": "mutation { orderCancel(orderId: \"{{10.id}}\", reason: CUSTOMER, refund: false, restock: true, notifyCustomer: false) { orderCancelUserErrors { field message } } }"}, "metadata": {"designer": {"x": 900, "y": 300, "name": "Cancel order (verify mutation at deploy)"}}},
{"id": 12, "module": "shopify:makeAnApiCall", "version": 3, "parameters": {}, "mapper": {"query": "mutation { add: tagsAdd(id: \"{{10.id}}\", tags: [\"cod-no-reply\"]) { userErrors { message } } remove: tagsRemove(id: \"{{10.id}}\", tags: [\"cod-pending\"]) { userErrors { message } } }"}, "metadata": {"designer": {"x": 1200, "y": 300, "name": "Tag cod-no-reply, remove cod-pending"}}},
{"id": 13, "module": "whatsapp-business-cloud:sendTemplateMessage", "version": 1, "parameters": {}, "mapper": {"fromId": "{{1.sender_id}}", "to": "{{10.shippingAddress.phone}}", "messageTemplate": "order_cancelled_no_reply"}, "metadata": {"designer": {"x": 1500, "y": 300, "name": "WhatsApp: order_cancelled_no_reply"}}},
{"id": 14, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblhK6iEKzos8bAue", "typecast": true, "useColumnId": true, "record": {"fld8CQl8czLLy0s5w": "COD order auto-cancelled (no reply): {{10.name}}", "fld29uaxQk5VmdXsI": "{{now}}", "fldUPfdwpl2mb1le5": "Orders & Shipping", "fldxsNlnxUGh8Xb3s": "Shopify", "fld0T8Dj1Kur6O9uZ": "Tag cod-pending", "fldStlIKxufuTP8MG": "Cancelled, tag cod-no-reply", "fldSGDQm5YJyb6gFD": "Success"}}, "metadata": {"designer": {"x": 1800, "y": 300, "name": "Agent Action Log"}}}
]}
]}
]}
