{"id": 8, "module": "shopify:makeAnApiCall", "version": 3, "parameters": {}, "mapper": {"query": "mutation { add: tagsAdd(id: \"{{last(split(2.button.payload; \"|\"))}}\", tags: [\"cod-cancelled\"]) { userErrors { message } } remove: tagsRemove(id: \"{{last(split(2.button.payload; \"|\"))}}\", tags: [\"cod-pending\"]) { userErrors { message } } }"}, "metadata": {"designer": {"x": 1200, "y": 0, "name": "Tag cod-cancelled"}}},
{"id": 9, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblhK6iEKzos8bAue", "typecast": true, "useColumnId": true, "record": {"fld8CQl8czLLy0s5w": "COD order cancelled by customer", "fld29uaxQk5VmdXsI": "{{now}}", "fldUPfdwpl2mb1le5": "Orders & Shipping", "fldxsNlnxUGh8Xb3s": "WhatsApp", "fld0T8Dj1Kur6O9uZ": "Tag cod-pending", "fldStlIKxufuTP8MG": "Cancelled, tag cod-cancelled", "fldSGDQm5YJyb6gFD": "Success", "fldLbMuGJoUDs1O3o": "Order {{last(split(2.button.payload; \"|\"))}}"}}, "metadata": {"designer": {"x": 1500, "y": 0, "name": "Agent Action Log"}}}
]},
{"flow": [
