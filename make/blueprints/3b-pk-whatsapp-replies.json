{"id": 6, "module": "airtable:ActionCreateRecord", "version": 3, "parameters": {}, "mapper": {"base": "appspopIsF0THCKer", "table": "tblhK6iEKzos8bAue", "typecast": true, "useColumnId": true, "record": {"fld8CQl8czLLy0s5w": "COD order confirmed by customer", "fld29uaxQk5VmdXsI": "{{now}}", "fldUPfdwpl2mb1le5": "Orders & Shipping", "fldxsNlnxUGh8Xb3s": "WhatsApp", "fld0T8Dj1Kur6O9uZ": "Tag cod-pending", "fldStlIKxufuTP8MG": "Tag cod-confirmed", "fldSGDQm5YJyb6gFD": "Success", "fldLbMuGJoUDs1O3o": "Order {{last(split(2.button.payload; \"|\"))}}"}}, "metadata": {"designer": {"x": 1500, "y": -300, "name": "Agent Action Log"}}}
]},
{"flow": [
